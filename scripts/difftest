#!/bin/sh
# 差分测试（设计文档 §13.3 第 4 层）：同一个脚本分别在 appine 和真正的 arm64 Linux 上
# 运行，比对输出和退出码。在有 docker 的宿主上运行：
#
#   scripts/difftest [-t 执行层] [-r] [-s 仓库目录] [用例名……]
#
# 用例是 tests/diff/<名字>.sh，由 guest 的 /bin/sh 执行，stderr 并入 stdout。真正的
# Linux 一侧是 docker 容器：先在 appine 里把仓库的根文件系统打包、导入成镜像，所以两边
# 运行的是完全相同的文件。镜像只在第一次或者带 -r 时生成，换了仓库要带 -r。用例里
# `# docker-run-options: …` 这一行的选项另外加给它的容器（比如 mount 要的 CAP_SYS_ADMIN）。
#
# 两边的输出写到 target/difftest/<名字>.native、.appine，下次运行时覆盖；不一致时另存
# 一份到 target/difftest/failed/<时刻>-t<执行层>-<名字>.*，重跑之后也还能查。appine-run
# 自己的 stderr 写到 <名字>.appine.err：里面有内核层报告的内部错误（内核 bug、放开 BKL 时
# 借着内核对象）时，输出一致也算失败。
#
# 仓库默认是 target/difftest/store，不存在时导入 minirootfs（先运行 scripts/fetch-rootfs），
# 再在 appine 里用 apk 安装用例需要的软件包，这一步要联网（沿用宿主或 docker 的代理）。
# 仓库必须在工作区里。appine-run 也在容器里运行，与原生一侧看到同一种网络（容器的 eth0、
# 路由、地址），网络类的用例才比得了：Linux arm64 宿主上放进 APPINE_IMAGE（默认是
# debian:trixie-slim，glibc 不能比编译 appine-run 的宿主旧）里运行，appine-run 可以用
# 环境变量 APPINE_RUN 指定；其他宿主上经由 scripts/dev。环境变量 APPINE_DBT_REGS 照样交给
# appine-run（APPINE_DBT_REGS=go 时所有程序都用 Tier 1 给 Go 的那组寄存器）。
set -eu

root=$(cd "$(dirname "$0")/.." && pwd)
cd "$root"
tier=1
rebuild=0
store=target/difftest/store
image=appine-difftest
packages="python3 gcc musl-dev lua5.4 sqlite go nodejs openjdk21-jdk strace gdb uv bubblewrap iproute2"
env_path=PATH=/usr/sbin:/usr/bin:/sbin:/bin

while getopts t:rs: opt; do
    case $opt in
    t) tier=$OPTARG ;;
    r) rebuild=1 ;;
    s) store=$OPTARG ;;
    *) exit 2 ;;
    esac
done
shift $((OPTIND - 1))

# linux <shell 命令>：在 Linux arm64 环境里执行，$http_proxy 这类变量在那边展开
if [ "$(uname -sm)" = "Linux aarch64" ]; then
    run=${APPINE_RUN:-target/linux-arm64/release/appine-run}
    [ -x "$run" ] || run=target/release/appine-run
    case $run in
    /*) ;;
    *) run=$root/$run ;;
    esac
    linux() { sh -c "$1"; }
    # 以调用者的身份运行，新建的仓库属于调用者，宿主上的 linux 也打得开；与 scripts/dev
    # 一样放开 nice 的上限（guest 线程的 nice 值设置到宿主线程上）
    appine() {
        docker run --rm --platform linux/arm64 --security-opt seccomp=unconfined \
            ${APPINE_DBT_REGS:+-e APPINE_DBT_REGS} \
            --user "$(id -u):$(id -g)" --ulimit nice=40:40 -v "$root:$root" -w "$root" \
            "${APPINE_IMAGE:-debian:trixie-slim}" "$run" "$@"
    }
else
    run=target/linux-arm64/release/appine-run
    linux() { scripts/dev sh -c "$1"; }
    appine() { scripts/dev "$run" "$@"; }
fi

if [ ! -d "$store" ]; then
    tarball=$(ls target/rootfs/alpine-minirootfs-*-aarch64.tar.gz 2>/dev/null | tail -n 1)
    [ -n "$tarball" ] || {
        echo "difftest: no minirootfs; run scripts/fetch-rootfs" >&2
        exit 1
    }
    echo "creating $store"
    appine --rootfs "$store" --import "$tarball" >/dev/null
    linux "$run --tier 1 --rootfs $store --env $env_path"' \
        ${http_proxy:+--env http_proxy=$http_proxy} ${https_proxy:+--env https_proxy=$https_proxy} \
        -- /bin/sh -c "apk add -q '"$packages"'"'
    rebuild=1
fi
# 只看目录在不在不够：安装中途失败、缓存只恢复了一部分的仓库会让每个用例都失败
if ! appine --tier 1 --rootfs "$store" --env "$env_path" -- \
    /bin/sh -c "command -v python3 gcc lua5.4 sqlite3 go node java strace gdb uv bwrap" >/dev/null 2>&1; then
    echo "difftest: $store lacks some of: $packages" >&2
    echo "difftest: install them with apk add, or delete $store to create it again" >&2
    exit 1
fi

if [ "$rebuild" = 1 ] || ! docker image inspect "$image" >/dev/null 2>&1; then
    echo "exporting the root filesystem of $store"
    appine --tier 1 --rootfs "$store" -- /bin/tar -c -f - -C / bin etc lib sbin usr tmp 2>/dev/null |
        docker import --platform linux/arm64 - "$image" >/dev/null
fi

out=target/difftest
mkdir -p "$out"
if [ $# -eq 0 ]; then
    set -- $(cd tests/diff && ls *.sh | sed 's/\.sh$//')
fi

failed=0
for name in "$@"; do
    script="exec 2>&1; $(cat "tests/diff/$name.sh")"
    # 脚本整个作为 sh -c 的一个参数交出去，Linux 不让单个参数超过 128 KB（MAX_ARG_STRLEN）：
    # 超过时两边都执行不了（E2BIG），输出一样，会被当成通过
    if [ "$(printf '%s' "cd / && $script" | wc -c)" -ge 131072 ]; then
        echo "FAIL $name: tests/diff/$name.sh is longer than one argument can be (128 KB), split it"
        failed=$((failed + 1))
        continue
    fi
    options=$(sed -n 's/^# docker-run-options: //p' "tests/diff/$name.sh")
    set +e
    # Docker 默认的 seccomp 规则会改掉一些 syscall 的结果（clone3 返回 ENOSYS，
    # pidfd_getfd 返回 EPERM），比对的应当是内核本身的行为
    # shellcheck disable=SC2086 # 选项要按空白拆开
    docker run --rm --platform linux/arm64 --security-opt seccomp=unconfined $options \
        -e "$env_path" -e HOME=/root -w / "$image" \
        /bin/sh -c "$script" >"$out/$name.native" 2>/dev/null
    echo "exit $?" >>"$out/$name.native"
    appine --tier "$tier" --rootfs "$store" --env "$env_path" --env HOME=/root -- \
        /bin/sh -c "cd / && $script" >"$out/$name.appine" 2>"$out/$name.appine.err"
    echo "exit $?" >>"$out/$name.appine"
    set -e
    bugs=$(grep '^appine: internal error' "$out/$name.appine.err" || true)
    if cmp -s "$out/$name.native" "$out/$name.appine" && [ -z "$bugs" ]; then
        echo "ok   $name"
    else
        echo "FAIL $name"
        diff -u "$out/$name.native" "$out/$name.appine" | sed 's/^/    /' || true
        [ -z "$bugs" ] || printf '%s\n' "$bugs" | sed 's/^/    /'
        kept=$out/failed/$(date +%Y%m%d-%H%M%S)-t$tier-$name
        mkdir -p "$out/failed"
        cp "$out/$name.native" "$kept.native"
        cp "$out/$name.appine" "$kept.appine"
        cp "$out/$name.appine.err" "$kept.appine.err"
        echo "    saved as $kept.native, .appine, .appine.err"
        failed=$((failed + 1))
    fi
done
[ "$failed" = 0 ] || {
    echo "$failed failed"
    exit 1
}
