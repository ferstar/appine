#!/bin/sh
# Sources to publish together with the app (design doc §13.4), placed in <output directory>
# (target/release-sources by default):
#
#   scripts/release-sources [output directory]
#
#   appine-<commit>.tar.gz            appine itself (git archive HEAD; an error when the work tree
#                                     has changes)
#   appine-<commit>-vendor.tar.gz     cargo vendor: the crates statically linked into the app
#   alpine-<version>-gpl-sources.tar  the GPL packages of the Alpine minirootfs in the APK: each
#                                     one's directory at its aports commit (APKBUILD, patches) and
#                                     the upstream sources
#   ghostty-<version>.tar.gz          the Ghostty source release libghostty-vt (the terminal) is
#                                     built from, as published (sha256 checked by fetch-ghostty)
#   ghostty-<version>-zig-packages.tar.gz
#                                     the Zig packages that build fetches (zig-pkg/ of the source:
#                                     uucode, Highway, Wuffs and what its configure phase reads)
#
# The Alpine part: packages, versions, licenses, and the aports origins and commits come from
# lib/apk/db/installed in the tarball (the open-source licenses page lists them too), and packages
# whose license includes GPL are deduplicated by origin. The aports directories are downloaded from
# GitLab by commit and subdirectory; the upstream sources are the files listed in the APKBUILD's
# sha512sums but missing from the directory, downloaded by file name from Alpine's distfiles
# mirror and checked against the SHA-512 there. The APKBUILD is not executed (source= has
# variables, and executing it would mean running downloaded code).
set -eu

root=$(cd "$(dirname "$0")/.." && pwd)
out=${1:-$root/target/release-sources}
mkdir -p "$out"
out=$(cd "$out" && pwd)
aports=https://gitlab.alpinelinux.org/alpine/aports/-/archive
distfiles=https://distfiles.alpinelinux.org/distfiles

sha512() {
    if command -v sha512sum >/dev/null; then
        sha512sum "$1"
    else
        shasum -a 512 "$1"
    fi | cut -d' ' -f1
}

# ---- appine itself ----
cd "$root"
if [ -n "$(git status --porcelain --untracked-files=no)" ]; then
    echo "release-sources: the work tree has changes; commit them first" >&2
    exit 1
fi
rev=$(git rev-parse --short=12 HEAD)
git archive --format=tar.gz --prefix="appine-$rev/" -o "$out/appine-$rev.tar.gz" HEAD
echo "$out/appine-$rev.tar.gz"

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
cargo vendor --locked --quiet "$work/vendor" >/dev/null
tar -czf "$out/appine-$rev-vendor.tar.gz" -C "$work" vendor
rm -rf "$work/vendor"
echo "$out/appine-$rev-vendor.tar.gz"

# ---- libghostty-vt: the Ghostty release and the Zig packages its build uses ----
gdir=$work/ghostty
mkdir -p "$gdir"
# Reuse the release tarball fetch-ghostty already downloaded and checked, if there is one
cp "$root"/target/ghostty/ghostty-*.tar.gz "$gdir"/ 2>/dev/null || true
# With an empty global cache only the packages the build uses end up in zig-pkg/
src=$(ZIG_GLOBAL_CACHE_DIR=$work/zig-cache "$root/scripts/fetch-ghostty" "$gdir" | sed -n 's/^fetch-ghostty: //p')
gname=$(basename "$src")
cp "$gdir/$gname.tar.gz" "$out/$gname.tar.gz"
echo "$out/$gname.tar.gz"
tar -czf "$out/$gname-zig-packages.tar.gz" -C "$src" zig-pkg
echo "$out/$gname-zig-packages.tar.gz"
rm -rf "$gdir" "$work/zig-cache"

# ---- The GPL packages in the Alpine minirootfs ----
tarball=$("$root/scripts/fetch-rootfs" | tail -n 1)
version=$(basename "$tarball" | sed -n 's/^alpine-minirootfs-\([0-9.]*\)-.*/\1/p')
branch=v${version%.*}
name=alpine-$version-gpl-sources
dir=$work/$name
mkdir -p "$dir"
# One line per package: package version origin commit license
tar -xzOf "$tarball" lib/apk/db/installed | awk -F: '
    /^P:/ { p = substr($0, 3) } /^V:/ { v = substr($0, 3) } /^L:/ { l = substr($0, 3) }
    /^o:/ { o = substr($0, 3) } /^c:/ { c = substr($0, 3) }
    /^$/ { if (p != "") print p, v, o, c, l; p = "" }
    END { if (p != "") print p, v, o, c, l }' >"$work/packages"
grep 'GPL' "$work/packages" >"$work/gpl" || true
if [ ! -s "$work/gpl" ]; then
    echo "release-sources: no GPL packages in $tarball?" >&2
    exit 1
fi
{
    echo "Source code of the GPL-licensed packages in the Alpine Linux $version minirootfs"
    echo "that the appine app bundles ($(basename "$tarball")). Each directory holds the"
    echo "package's directory in Alpine's aports repository at the given commit (the"
    echo "APKBUILD and patches) and the upstream sources that the APKBUILD names, checked"
    echo "against its sha512sums."
    echo
    echo "package version origin aports-commit license"
    cat "$work/gpl"
} >"$dir/README"

awk '{ print $3, $4 }' "$work/gpl" | sort -u | while read -r origin commit; do
    dest=$dir/$origin
    mkdir -p "$dest"
    curl -fsSL --retry 3 -o "$work/aports.tar.gz" \
        "$aports/$commit/aports-$commit.tar.gz?path=main/$origin"
    tar -xzf "$work/aports.tar.gz" -C "$dest" --strip-components 3
    rm "$work/aports.tar.gz"
    [ -f "$dest/APKBUILD" ] || { echo "release-sources: no APKBUILD for main/$origin at $commit" >&2; exit 1; }
    # sha512sums="<digest>  <file>…": the quotes may be single or double, and the first entry
    # may be on the same line as sha512sums=
    awk '/^sha512sums=/ { f = 1; sub(/^sha512sums=["'\'']/, "") }
         f { line = $0; done = sub(/["'\'']$/, "", line); n = split(line, a, " ");
             if (n == 2) print a[1], a[2]; if (done) exit }' "$dest/APKBUILD" >"$work/sums"
    [ -s "$work/sums" ] || { echo "release-sources: no sha512sums in main/$origin/APKBUILD" >&2; exit 1; }
    while read -r want file; do
        if [ -e "$dest/$file" ]; then
            got=$(sha512 "$dest/$file")
        else
            curl -fsSL --retry 3 -o "$dest/$file" "$distfiles/$branch/$file" ||
                curl -fsSL --retry 3 -o "$dest/$file" "$distfiles/edge/$file" || {
                echo "release-sources: $file (main/$origin) is not on $distfiles" >&2
                exit 1
            }
            got=$(sha512 "$dest/$file")
        fi
        if [ "$got" != "$want" ]; then
            echo "release-sources: sha512 mismatch for $file (main/$origin)" >&2
            exit 1
        fi
    done <"$work/sums"
    echo "main/$origin at $commit: $(wc -l <"$work/sums" | tr -d ' ') files"
done

tar -cf "$out/$name.tar" -C "$work" "$name"
echo "$out/$name.tar"
