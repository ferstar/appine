#!/bin/sh
# Downloads and verifies the Ghostty source release that libghostty-vt, the terminal of the app's
# tabs, is built from (android/native and android/terminal maps), then fetches the Zig packages its
# build needs into the source's zig-pkg/, so that the cargo build (hosts/android/build.rs) works
# offline. The version and sha256 are fixed here and changed together on upgrades; Ghostty 1.4.0
# needs Zig 0.17.0. Usage: scripts/fetch-ghostty [output directory], target/ghostty by default; the
# source ends up in <output directory>/ghostty-<version>.
#
# Only the pinned sha256 is checked here. When upgrading, check the new release's minisign
# signature (<url>.minisig, with the key on ghostty.org) once before pinning its sha256. The Zig
# packages are checked by Zig against the hashes in the source's build.zig.zon files.
#
# Zig's HTTP client fails through some proxies (HTTP 400 from deps.files.ghostty.org through
# Clash and similar), so the proxy variables are removed for the fetch.
set -eu

version=1.4.0
sha256=cb188ac6c3a8278d5fd7bfef15d8c017104c87f638b5560eb38024a71ae0f005
name=ghostty-$version.tar.gz
url=https://release.files.ghostty.org/$version/$name

root=$(cd "$(dirname "$0")/.." && pwd)
out=${1:-$root/target/ghostty}
mkdir -p "$out"

# GNU and BSD sha256sum take different arguments, but the first column is the digest in both
digest() {
    if command -v sha256sum >/dev/null; then
        sha256sum "$1"
    else
        shasum -a 256 "$1"
    fi | cut -d' ' -f1
}

if ! [ -f "$out/$name" ] || [ "$(digest "$out/$name")" != "$sha256" ]; then
    curl -fsSL --retry 3 -o "$out/$name.part" "$url"
    if [ "$(digest "$out/$name.part")" != "$sha256" ]; then
        echo "fetch-ghostty: sha256 mismatch for $url: got $(digest "$out/$name.part")" >&2
        rm -f "$out/$name.part"
        exit 1
    fi
    mv "$out/$name.part" "$out/$name"
fi

src=$out/ghostty-$version
if ! [ -f "$src/build.zig" ]; then
    rm -rf "$src"
    tar -xzf "$out/$name" -C "$out"
fi

# Lazy dependencies are fetched only when the build script asks for them: run its configure phase
# with build.rs's options (--help stops before building), which fetches exactly what that build
# uses. Packages already in Zig's global cache are unpacked into zig-pkg/ too, needed or not; with
# an empty cache (ZIG_GLOBAL_CACHE_DIR) only the needed ones are (scripts/release-sources)
cd "$src"
env -u HTTP_PROXY -u HTTPS_PROXY -u ALL_PROXY -u http_proxy -u https_proxy -u all_proxy \
    zig build -Demit-lib-vt -Dcpu=baseline -Doptimize=ReleaseFast -Dtarget=aarch64-linux-android \
    --help >/dev/null
echo "fetch-ghostty: $src"
