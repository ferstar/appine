<?xml version="1.0" encoding="utf-8"?>
<!-- A row of the list of tabs: the tab's label, and a button that closes it. The terminal's
     activity is not an AppCompat one, so these are the framework's views (the icon carries its
     own tint). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="48dp"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="8dp"
        android:paddingBottom="12dp"
        android:textAppearance="?attr/textAppearanceBodyLarge" />

    <!-- Not focusable, so the rest of the row still takes the list's taps -->
    <ImageView
        android:id="@+id/close"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="4dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/close_tab"
        android:focusable="false"
        android:scaleType="center"
        android:src="@drawable/ic_close" />
</LinearLayout>
