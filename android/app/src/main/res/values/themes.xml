<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Settings and the license pages: Material 3, light or dark with the system, with the
         wallpaper's colours from Android 12 on (DynamicColors in their onCreate) -->
    <style name="Theme.Appine" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">?attr/colorSurface</item>
    </style>

    <!-- The terminal: Material 3 but always dark, on black, with the wallpaper's colours from
         Android 12 on (its dialogs, menus and the list of tabs; DynamicColors in onCreate). The
         system bars stay black, as with the framework theme before, where they are coloured at
         all (up to Android 14) -->
    <style name="Theme.Appine.Terminal" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>
</resources>
