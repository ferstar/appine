<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Networking for guest programs (socket passthrough) and the mirror speed probe at first
         start -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The default network's routes go into the guest's routing table (design doc §10) -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- PARTIAL_WAKE_LOCK is held when "Keep running with the screen off" is on in Settings
         (the android/service map) -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.Appine">

        <!-- Settings and the license pages leave out uiMode: they follow the system's dark mode,
             so a change recreates them with the other colours -->

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Appine.Terminal"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|density"
            android:exported="false"
            android:label="@string/settings" />

        <activity
            android:name=".LicensesActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|density"
            android:exported="false"
            android:label="@string/settings_licenses" />

        <!-- The android/documents map: the home directory in the system Files app (and optionally
             the whole system, read-only); only the system (the Files app, which holds
             MANAGE_DOCUMENTS) has direct access, other apps go through grants the user picks
             there -->
        <provider
            android:name=".Documents"
            android:authorities="${applicationId}.documents"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>

        <!-- The android/service map: a specialUse foreground service is kept while sessions run -->
        <service
            android:name=".TerminalService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Runs the command-line programs that the user starts in a terminal session." />
        </service>
    </application>
</manifest>
